    [xml]$addUrlXaml = @"
    <Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            Title="Download File Info - AUMYS" Height="360" Width="600" Background="#FFF0F0F0" WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize" FontFamily="Segoe UI">
        <Grid Margin="15">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="URL" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <TextBox Name="UrlInput" Grid.Column="1" Height="25" Padding="3" BorderBrush="#FFADADAD"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Category" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <ComboBox Name="CatSelector" Grid.Column="1" Height="25">
                        <ComboBoxItem Content="Media (yt-dlp)"/>
                        <ComboBoxItem Content="Direct File (aria2)"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Save As" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <TextBox Name="SavePathInput" Grid.Column="1" Height="25" Padding="3" BorderBrush="#FFADADAD"/>
                    <Button Name="BrowseSaveBtn" Content="..." Grid.Column="2" Width="30" Height="25" Margin="5,0,0,0" Background="#FFE1E1E1" BorderBrush="#FFADADAD"/>
                </Grid>

                <GroupBox Name="MediaOptionsGroup" Header="Media Options (AUMYS)" Margin="80,0,0,15" Foreground="#FF007ACC" BorderBrush="#FFCCCCCC">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Video Quality:" Margin="0,0,0,2"/>
                            <ComboBox Name="PresetSelector" Height="24" Margin="0,0,10,10">
                                <ComboBoxItem Content="TV MP4 1080p (H.264)" IsSelected="True"/>
                                <ComboBoxItem Content="TV MP4 720p (H.264)"/>
                                <ComboBoxItem Content="MP4 4K (Best)"/>
                                <ComboBoxItem Content="MP3 Audio"/>
                            </ComboBox>
                            <CheckBox Name="SubsCheck" Content="Download Subtitles (En/Ur)"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Playlist Range:" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox Name="PlayStart" Width="30" Text="1" TextAlignment="Center"/>
                                <TextBlock Text=" to " VerticalAlignment="Center"/>
                                <TextBox Name="PlayEnd" Width="30" Text="0" TextAlignment="Center"/>
                            </StackPanel>
                            <CheckBox Name="SponsorCheck" Content="Skip Sponsor Segments"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Name="LaterBtn" Content="Download Later" Width="110" Height="28" Margin="0,0,15,0" Background="#FFE1E1E1" BorderBrush="#FFADADAD"/>
                        <Button Name="StartBtn" Content="Start Download" Width="110" Height="28" Margin="0,0,15,0" Background="#FFE1E1E1" BorderBrush="#FF007ACC" BorderThickness="2" FontWeight="Bold"/>
                        <Button Name="CancelBtn" Content="Cancel" Width="90" Height="28" Background="#FFE1E1E1" BorderBrush="#FFADADAD"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Window>
"@
    $addWin = [Windows.Markup.XamlReader]::Load((New-Object System.Xml.XmlNodeReader $addUrlXaml))
    $addWin.Owner = $window
    $addWin.FindName("SavePathInput").Text = $global:defaultSavePath

    try {
        if ([System.Windows.Forms.Clipboard]::ContainsText()) {
            $clipText = [System.Windows.Forms.Clipboard]::GetText()
            if ($clipText -and $clipText.Trim() -match "^https?://") { 
                $addWin.FindName("UrlInput").Text = $clipText.Trim() 
                if ($clipText -match "(youtube|facebook|twitter|tiktok)") { $addWin.FindName("CatSelector").SelectedIndex = 0; $addWin.FindName("MediaOptionsGroup").Visibility = "Visible" } 
                else { $addWin.FindName("CatSelector").SelectedIndex = 1; $addWin.FindName("MediaOptionsGroup").Visibility = "Collapsed" }
            }
        }
    } catch {}

    $addWin.FindName("UrlInput").Add_TextChanged({
        $t = $addWin.FindName("UrlInput").Text
        if ($t -match "(youtube|facebook|twitter|tiktok)") { $addWin.FindName("CatSelector").SelectedIndex = 0; $addWin.FindName("MediaOptionsGroup").Visibility = "Visible" } 
        else { $addWin.FindName("CatSelector").SelectedIndex = 1; $addWin.FindName("MediaOptionsGroup").Visibility = "Collapsed" }
    })

    $addWin.FindName("BrowseSaveBtn").Add_Click({
        $d=New-Object System.Windows.Forms.FolderBrowserDialog
        if($d.ShowDialog() -eq "OK"){$addWin.FindName("SavePathInput").Text=$d.SelectedPath}
    })
    $addWin.FindName("CancelBtn").Add_Click({ $addWin.Close() })

    function Create-Task($StartImmediately) {
        $url = $addWin.FindName("UrlInput").Text.Trim()
        if ($url -eq "") { return }
        $isMedia = ($addWin.FindName("CatSelector").SelectedIndex -eq 0)
        $parsedList = @()
        
        if ($isMedia) {
            $addWin.Cursor = [System.Windows.Input.Cursors]::Wait
            $window.FindName("StatusBarText").Text = "Extracting Playlist Links..."
            [System.Windows.Forms.Application]::DoEvents()

            $pInfo = New-Object System.Diagnostics.ProcessStartInfo
            $pInfo.FileName = Join-Path (Split-Path -Parent ([System.Diagnostics.Process]::GetCurrentProcess().MainModule.FileName)) "yt-dlp.exe"
            $pArgs = @("--flat-playlist", "--print", "`"%(title)s||%(url)s`"")
            $pS = $addWin.FindName("PlayStart").Text; $pE = $addWin.FindName("PlayEnd").Text
            if ($pS -match "^\d+$" -and [int]$pS -gt 0) { $pArgs += "--playlist-start", $pS }
            if ($pE -match "^\d+$" -and [int]$pE -gt 0) { $pArgs += "--playlist-end", $pE }
            $pArgs += "`"$url`""
            
            $pInfo.Arguments = $pArgs -join " "
            $pInfo.RedirectStandardOutput = $true; $pInfo.UseShellExecute = $false; $pInfo.CreateNoWindow = $true
            
            try {
                $pProc = [System.Diagnostics.Process]::Start($pInfo)
                $pOut = $pProc.StandardOutput.ReadToEnd()
                $pProc.WaitForExit()
                foreach ($l in ($pOut -split "`n" | Where-Object { $_.Trim() -ne "" })) {
                    $parts = $l -split "\|\|"
                    $vTitle = $parts[0].Trim()
                    $vUrl = if ($parts.Count -gt 1 -and $parts[1].Trim() -ne "") { $parts[1].Trim() } else { $url }
                    if ($vUrl -notmatch "^http") { $vUrl = $url }
                    $parsedList += @{ Title = $vTitle; Url = $vUrl }
                }
            } catch {}
            $addWin.Cursor = [System.Windows.Input.Cursors]::Arrow
        }
        if ($parsedList.Count -eq 0) { $parsedList += @{ Title = "Connecting..."; Url = $url } }

        foreach ($item in $parsedList) {
            $id = [guid]::NewGuid().ToString("N")
            $log = Join-Path $env:TEMP "ytpl_$id.log"
            
            $task = New-Object DownloadTask
            $task.Id = $id; $task.Url = $item.Url; $task.FileName = $item.Title; $task.Size = "--"; $task.Progress = 0
            $task.ProgressText = "0%"; $task.TransferRate = "Queued"; $task.TimeLeft = "--:--"; $task.LogFile = $log; $task.LastReadIndex = 0
            $task.SavePath = $addWin.FindName('SavePathInput').Text
            $task.OpenOnComplete = $false
            $task.Status = if ($StartImmediately) { "Queued" } else { "Paused" }

            $psi = New-Object System.Diagnostics.ProcessStartInfo
            $psi.RedirectStandardOutput = $true; $psi.RedirectStandardError = $true; $psi.UseShellExecute = $false; $psi.CreateNoWindow = $true

            if ($isMedia) {
                $task.Engine = "yt-dlp"
                $psi.FileName = Join-Path (Split-Path -Parent ([System.Diagnostics.Process]::GetCurrentProcess().MainModule.FileName)) "yt-dlp.exe"
                $args = @("--newline", "--ignore-errors", "-o", "`"$($task.SavePath)\%(title)s.%(ext)s`"")
                
                if ($global:defaultSpeedLimit -ne "Unlimited") { $args += "--limit-rate", $global:defaultSpeedLimit }

                $preset = $addWin.FindName("PresetSelector").Text
                if ($preset -match "MP3") { $args += "-x", "--audio-format", "mp3" }
                elseif ($preset -match "TV MP4 1080p") { $args += "-f", "bestvideo[vcodec^=avc1][height<=1080]+bestaudio/best", "--merge-output-format", "mp4" }
                elseif ($preset -match "TV MP4 720p") { $args += "-f", "bestvideo[vcodec^=avc1][height<=720]+bestaudio/best", "--merge-output-format", "mp4" }
                elseif ($preset -match "4K") { $args += "-f", "bestvideo+bestaudio/best", "--merge-output-format", "mp4" }
                
                if ($addWin.FindName("SubsCheck").IsChecked) { $args += "--write-subs", "--write-auto-subs", "--sub-langs", "en,ur", "--embed-subs" }
                if ($addWin.FindName("SponsorCheck").IsChecked) { $args += "--sponsorblock-remove", "sponsor" }

                $args += "`"$($item.Url)`""
                $psi.Arguments = $args -join " "
            } else {
                $task.Engine = "aria2c"
                $psi.FileName = Join-Path (Split-Path -Parent ([System.Diagnostics.Process]::GetCurrentProcess().MainModule.FileName)) "aria2c.exe"
                $ariaArgs = "--dir=`"$($task.SavePath)`" -x16 -s16 --continue=true"
                if ($global:defaultSpeedLimit -ne "Unlimited") { $ariaArgs += " --max-download-limit=$($global:defaultSpeedLimit)" }
                $ariaArgs += " `"$($item.Url)`""
                $psi.Arguments = $ariaArgs
            }
            $task.StartInfo = $psi
            $global:tasks.Add($task)
        }
        $view.Refresh()
        $addWin.Close()
    }

    $addWin.FindName("StartBtn").Add_Click({ Create-Task $true })
    $addWin.FindName("LaterBtn").Add_Click({ Create-Task $false })
    $addWin.ShowDialog() | Out-Null
}

$window.FindName("AddUrlBtn").Add_Click({ Show-AddUrlDialog })
$window.FindName("MenuAddUrl").Add_Click({ Show-AddUrlDialog })

# ---------------------------------------------------------
# Fully Functional Top Menus & Context Menu Actions
# ---------------------------------------------------------
function Trigger-Resume {
    $sel = $window.FindName("MainList").SelectedItem
    if ($null -ne $sel -and $sel.Status -in @("Paused", "Error", "Cancelled")) {
        $sel.Status = "Queued"; $sel.TransferRate = "Waiting in queue..."
    }
}
function Trigger-Stop {
    $sel = $window.FindName("MainList").SelectedItem
    if ($null -ne $sel -and $sel.Status -in @("Downloading", "Connecting", "Queued")) {
        if ($null -ne $sel.Process) { try { if (-not $sel.Process.HasExited) { $sel.Process.Kill() } } catch {} }
        $sel.Status = "Paused"; $sel.TransferRate = "Stopped"
    }
}
function Trigger-Delete {
    $sel = $window.FindName("MainList").SelectedItem
    if ($null -ne $sel) {
        if ($null -ne $sel.Process) { try { if (-not $sel.Process.HasExited) { $sel.Process.Kill() } } catch {} }
        $global:tasks.Remove($sel)
    }
}

$window.FindName("ResumeBtn").Add_Click({ Trigger-Resume })
$window.FindName("CtxResumeBtn").Add_Click({ Trigger-Resume })
$window.FindName("MenuResume").Add_Click({ Trigger-Resume })

$window.FindName("StopBtn").Add_Click({ Trigger-Stop })
$window.FindName("CtxStopBtn").Add_Click({ Trigger-Stop })
$window.FindName("MenuStop").Add_Click({ Trigger-Stop })

$window.FindName("DeleteBtn").Add_Click({ Trigger-Delete })
$window.FindName("CtxDeleteBtn").Add_Click({ Trigger-Delete })
$window.FindName("MenuDelete").Add_Click({ Trigger-Delete })

$window.FindName("CtxOpenFolderBtn").Add_Click({
    $sel = $window.FindName("MainList").SelectedItem
    if ($null -ne $sel -and $null -ne $sel.SavePath) { try { Invoke-Item $sel.SavePath } catch {} }
})
$window.FindName("CtxStatusBtn").Add_Click({
    $sel = $window.FindName("MainList").SelectedItem
    if ($null -ne $sel) { Show-StatusDialog -Task $sel }
})
$window.FindName("MenuDeleteCompleted").Add_Click({
    $completed = @($global:tasks | Where-Object { $_.Status -eq "Finished" })
    foreach ($c in $completed) { $global:tasks.Remove($c) }
})
$window.FindName("MenuPauseAll").Add_Click({
    foreach ($t in $global:tasks) {
        if ($t.Status -in @("Downloading", "Connecting", "Queued")) {
            if ($null -ne $t.Process) { try { if (-not $t.Process.HasExited) { $t.Process.Kill() } } catch {} }
            $t.Status = "Paused"; $t.TransferRate = "Stopped"
        }
    }
})
$window.FindName("MenuExit").Add_Click({ $window.Close() })

$window.Add_Loaded({
    $window.FindName("MainList").Add_MouseDoubleClick({
        $sel = $window.FindName("MainList").SelectedItem
        if ($null -ne $sel) { Show-StatusDialog -Task $sel }
    })
    $uiTimer.Start()
})

$window.Add_Closing({ foreach($t in $global:tasks){ if($null -ne $t.Process){ try{ if(-not $t.Process.HasExited){ $t.Process.Kill() } }catch{} } } })
$window.ShowDialog() | Out-Null
