# ==========================================
# YTPL Downloader - Ultimate Pro Edition v4.0
# Features: Subtitles, Cookies, Thumbnails, Auto-Grabber
# ==========================================

Add-Type -AssemblyName PresentationFramework
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

[xml]$xaml = @"
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="YTPL Downloader - Ultimate Pro Edition" Height="820" Width="680"
        Background="#FF1E1E1E" Foreground="White" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF0098FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF555555"/>
                    <Setter Property="Foreground" Value="#FFAAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="YTPL Downloader PRO" FontSize="26" FontWeight="Bold" Foreground="#FF569CD6" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Media URLs (Queue supported):" Margin="0,0,0,5"/>
                <CheckBox Name="ClipMonitorCheck" Grid.Column="1" Content="Auto-grab links from Clipboard" IsChecked="True" Foreground="#FFF2C811" FontWeight="SemiBold" Margin="0,0,0,5"/>
            </Grid>
            <TextBox Name="UrlInput" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5" Background="#FF2D2D30" Foreground="White" BorderBrush="#FF3F3F46"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Playlist Start:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Name="PlaylistStart" Width="40" Text="1" Background="#FF2D2D30" Foreground="White" TextAlignment="Center"/>
                <TextBlock Text="End (0 for all):" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBox Name="PlaylistEnd" Width="40" Text="0" Background="#FF2D2D30" Foreground="White" TextAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Output &amp; Save Settings" Foreground="White" BorderBrush="#FF3F3F46" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <TextBlock Text="Video Quality / Preset:" Margin="0,0,0,5"/>
                <ComboBox Name="PresetSelector" Height="25" Margin="0,0,0,10">
                    <ComboBoxItem Content="TV MP4 1080p (H.264 + AAC)" IsSelected="True"/>
                    <ComboBoxItem Content="TV MP4 720p (H.264 + AAC)"/>
                    <ComboBoxItem Content="TV MP4 480p (H.264 + AAC)"/>
                    <ComboBoxItem Content="MP4 1080p (Best)"/>
                    <ComboBoxItem Content="MP4 720p (Best)"/>
                    <ComboBoxItem Content="MP4 480p (Best)"/>
                    <ComboBoxItem Content="MKV (Best)"/>
                    <ComboBoxItem Content="WebM (Best)"/>
                    <ComboBoxItem Content="MP3 Audio"/>
                </ComboBox>

                <TextBlock Text="Save Directory:" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="SaveFolderInput" Grid.Column="0" Height="25" Padding="5" Background="#FF2D2D30" Foreground="White" BorderBrush="#FF3F3F46" IsReadOnly="True"/>
                    <Button Name="BrowseBtn" Grid.Column="1" Content="Browse..." Width="70" Margin="10,0,0,0"/>
                    <Button Name="OpenFolderBtn" Grid.Column="2" Content="Open Folder" Width="90" Background="#FF4F4F4F" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- NEW: Pro Features (Subtitles, Cookies, Formatting) -->
        <GroupBox Grid.Row="3" Header="Pro Features (Metadata &amp; Auth)" Foreground="White" BorderBrush="#FF3F3F46" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <CheckBox Name="SubtitlesCheck" Content="Download &amp; Embed Subtitles (En/Ur)" Foreground="White" Margin="0,0,0,8"/>
                    <CheckBox Name="ThumbnailCheck" Content="Download Video Thumbnail (JPG)" Foreground="White" Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Browser Cookies (For Private/18+ Vids):" Margin="0,0,0,2"/>
                    <ComboBox Name="CookiesSelector" Height="25" Margin="0,0,0,8">
                        <ComboBoxItem Content="None (Default)" IsSelected="True"/>
                        <ComboBoxItem Content="Chrome"/>
                        <ComboBoxItem Content="Edge"/>
                        <ComboBoxItem Content="Firefox"/>
                        <ComboBoxItem Content="Brave"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="File Naming Format:" Margin="0,0,0,2"/>
                    <ComboBox Name="NamingSelector" Height="25" Margin="0,0,0,8">
                        <ComboBoxItem Content="Video Title (Default)" IsSelected="True"/>
                        <ComboBoxItem Content="Channel Name - Video Title"/>
                        <ComboBoxItem Content="Upload Date - Video Title"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Connection &amp; Automation" Foreground="White" BorderBrush="#FF3F3F46" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Max Connections (Threads):" Margin="0,0,0,2"/>
                    <ComboBox Name="ThreadsSelector" Height="25" Margin="0,0,0,8">
                        <ComboBoxItem Content="1 (Single Connection)"/>
                        <ComboBoxItem Content="16 Threads (IDM Default)" IsSelected="True"/>
                    </ComboBox>
                    
                    <TextBlock Text="Speed Limit:" Margin="0,0,0,2"/>
                    <ComboBox Name="SpeedLimitSelector" Height="25" Margin="0,0,0,8">
                        <ComboBoxItem Content="Unlimited" IsSelected="True"/>
                        <ComboBoxItem Content="1M"/>
                        <ComboBoxItem Content="5M"/>
                        <ComboBoxItem Content="10M"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Action on Completion:" Margin="0,0,0,2"/>
                    <ComboBox Name="PostActionSelector" Height="25" Margin="0,0,0,8">
                        <ComboBoxItem Content="Show Dialog (Default)" IsSelected="True"/>
                        <ComboBoxItem Content="Exit Application"/>
                        <ComboBoxItem Content="Shutdown PC"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBox Name="LogBox" Grid.Row="5" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#FF121212" Foreground="#FF9CDCFE" FontFamily="Consolas" Padding="5"/>
        <TextBlock Name="StatusLabel" Grid.Row="6" Text="Status: Ready." FontSize="14" FontWeight="Bold" Foreground="#FF808080" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="DownloadBtn" Content="Start Download" Width="140" Background="#FF28A745" Height="35" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
"@

$reader = (New-Object System.Xml.XmlNodeReader $xaml)
$window = [Windows.Markup.XamlReader]::Load($reader)

# ---------------------------------------------------------
# Variables & Globals
# ---------------------------------------------------------
$BrowseBtn = $window.FindName("BrowseBtn")
$OpenFolderBtn = $window.FindName("OpenFolderBtn")
$ClipMonitorCheck = $window.FindName("ClipMonitorCheck")
$SubtitlesCheck = $window.FindName("SubtitlesCheck")
$ThumbnailCheck = $window.FindName("ThumbnailCheck")
$CookiesSelector = $window.FindName("CookiesSelector")
$NamingSelector = $window.FindName("NamingSelector")
$SaveFolderInput = $window.FindName("SaveFolderInput")
$DownloadBtn = $window.FindName("DownloadBtn")
$UrlInput = $window.FindName("UrlInput")
$LogBox = $window.FindName("LogBox")
$StatusLabel = $window.FindName("StatusLabel")
$PresetSelector = $window.FindName("PresetSelector")
$SpeedLimitSelector = $window.FindName("SpeedLimitSelector")
$ThreadsSelector = $window.FindName("ThreadsSelector")
$PostActionSelector = $window.FindName("PostActionSelector")

$SaveFolderInput.Text = [Environment]::GetFolderPath("Desktop")

$global:activeProcess = $null
$global:lastProcessInfo = $null
$global:tempLogFile = "$env:TEMP\ytpl_download_log.txt"
$global:lastLogLineCount = 0
$global:currentFilePath = ""
$global:progressWindow = $null
$global:isPaused = $false

function Update-UI { $window.Dispatcher.Invoke([Action]{}, [System.Windows.Threading.DispatcherPriority]::Background) }

# ---------------------------------------------------------
# UI Timer (Clipboard, Logs, Process Exit)
# ---------------------------------------------------------
$uiTimer = New-Object System.Windows.Threading.DispatcherTimer
$uiTimer.Interval = [TimeSpan]::FromMilliseconds(500)
$uiTimer.Add_Tick({
    if ($ClipMonitorCheck.IsChecked -and $global:activeProcess -eq $null) {
        try {
            if ([System.Windows.Forms.Clipboard]::ContainsText()) {
                $clipText = [System.Windows.Forms.Clipboard]::GetText().Trim()
                if ($clipText -match "^https?://(www\.)?(youtube\.com|youtu\.be)" -and $UrlInput.Text -notmatch [regex]::Escape($clipText)) {
                    if ($UrlInput.Text -ne "") { $UrlInput.AppendText("`r`n") }
                    $UrlInput.AppendText($clipText)
                    [System.Windows.Forms.Clipboard]::Clear()
                    $StatusLabel.Text = "Status: Link auto-grabbed from clipboard!"
                    $StatusLabel.Foreground = "#FFF2C811"
                }
            }
        } catch {}
    }

    if (Test-Path $global:tempLogFile) {
        $lines = @(Get-Content $global:tempLogFile -ErrorAction SilentlyContinue)
        $currentCount = $lines.Count
        
        if ($currentCount -gt $global:lastLogLineCount) {
            for ($i = $global:lastLogLineCount; $i -lt $currentCount; $i++) {
                $line = $lines[$i]
                if (-not [string]::IsNullOrWhiteSpace($line)) {
                    $LogBox.AppendText($line + "`r`n")
                    $LogBox.ScrollToEnd()
                    
                    if ($line -match '\[download\] Destination:\s+(.+)') {
                        $global:currentFilePath = $matches[1]
                    } elseif ($line -match '\[Merger\] Merging formats into\s+"(.+)"') {
                        $global:currentFilePath = $matches[1]
                    }
                    
                    if ($global:progressWindow -ne $null -and $global:progressWindow.IsLoaded) {
                        if ($line -match '\[download\] Destination:\s+(.+)') {
                            $global:progressWindow.FindName("PTitle").Text = Split-Path $matches[1] -Leaf
                        }
                        
                        if ($line -match '\[download\]\s+(?<percent>\d+\.\d+)%\s+of\s+[~]*(?<size>[0-9A-Za-z\.]+)\s+at\s+(?<speed>[0-9A-Za-z\.\/]+)\s+ETA\s+(?<eta>[\d:]+)') {
                            $global:progressWindow.FindName("PBar").Value = [double]$matches.percent
                            $global:progressWindow.FindName("PPercent").Text = "$($matches.percent)%"
                            $global:progressWindow.FindName("PSize").Text = $matches.size
                            $global:progressWindow.FindName("PSpeed").Text = "Speed: $($matches.speed)"
                            $global:progressWindow.FindName("PEta").Text = "ETA: $($matches.eta)"
                        }
                    }
                }
            }
            $global:lastLogLineCount = $currentCount
        }
    }

    if ($global:activeProcess -ne $null -and $global:activeProcess.HasExited) {
        if (-not $global:isPaused) {
            $uiTimer.Stop()
            $global:activeProcess = $null
            
            if ($global:progressWindow -ne $null) {
                $global:progressWindow.Close()
                $global:progressWindow = $null
            }

            $StatusLabel.Text = "Status: Ready."
            $StatusLabel.Foreground = "#FF808080"
            $DownloadBtn.IsEnabled = $true
            
            $action = $PostActionSelector.Text
            if ($action -match "Shutdown PC") { Stop-Computer -Force } 
            elseif ($action -match "Exit Application") { $window.Close() } 
            else { Show-CompleteDialog }
        }
    }
})

# ---------------------------------------------------------
# Dynamic Dialog Builders
# ---------------------------------------------------------
function Show-ProgressDialog {
    [xml]$pXaml = @"
    <Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            Title="Downloading File..." Height="230" Width="500"
            Background="#FF1E1E1E" Foreground="White" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True">
        <Grid Margin="15">
            <StackPanel>
                <TextBlock Text="Downloading:" FontSize="14" Foreground="#FF569CD6" Margin="0,0,0,5"/>
                <TextBlock Name="PTitle" Text="Connecting to server..." FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,15" Foreground="#FFFFD700"/>
                
                <ProgressBar Name="PBar" Height="25" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10" Background="#FF2D2D30" Foreground="#FF28A745" BorderBrush="#FF3F3F46"/>
                
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="PPercent" Grid.Column="0" Text="0.0%" FontWeight="Bold" Foreground="#FF569CD6"/>
                    <TextBlock Name="PSize" Grid.Column="1" Text="-- MB" HorizontalAlignment="Center" Foreground="#FFCE9178"/>
                    <TextBlock Name="PSpeed" Grid.Column="2" Text="Speed: --" HorizontalAlignment="Right" Foreground="#FF4EC9B0"/>
                </Grid>
                <Grid>
                    <TextBlock Name="PEta" Text="ETA: --:--" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FF808080"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="PPauseBtn" Content="⏸ Pause" Width="80" Background="#FFF2C811" Foreground="Black" BorderThickness="0" Padding="5" Cursor="Hand" Margin="0,0,10,0"/>
                        <Button Name="PCancel" Content="⏹ Cancel" Width="80" Background="#FFD13438" Foreground="White" BorderThickness="0" Padding="5" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Window>
"@
    $pReader = (New-Object System.Xml.XmlNodeReader $pXaml)
    $global:progressWindow = [Windows.Markup.XamlReader]::Load($pReader)
    $global:progressWindow.Owner = $window

    $global:progressWindow.FindName("PPauseBtn").Add_Click({
        $btn = $global:progressWindow.FindName("PPauseBtn")
        if ($global:isPaused) {
            $global:isPaused = $false
            $btn.Content = "⏸ Pause"
            $btn.Background = "#FFF2C811"
            $btn.Foreground = "Black"
            
            $global:activeProcess = [System.Diagnostics.Process]::Start($global:lastProcessInfo)
            
            $runspaceCode = {
                param($process, $logFile)
                while (-not $process.HasExited) {
                    $line = $process.StandardOutput.ReadLine()
                    if ($line) { Add-Content -Path $logFile -Value $line }
                }
            }
            $ps = [PowerShell]::Create().AddScript($runspaceCode).AddArgument($global:activeProcess).AddArgument($global:tempLogFile)
            $ps.BeginInvoke() | Out-Null
        } else {
            $global:isPaused = $true
            $btn.Content = "▶ Resume"
            $btn.Background = "#FF28A745"
            $btn.Foreground = "White"
            if ($global:activeProcess -ne $null -and -not $global:activeProcess.HasExited) { $global:activeProcess.Kill() }
        }
    })

    $global:progressWindow.FindName("PCancel").Add_Click({
        if ($global:activeProcess -ne $null -and -not $global:activeProcess.HasExited) { $global:activeProcess.Kill() }
        $global:progressWindow.Close()
        $global:activeProcess = $null
        $StatusLabel.Text = "Status: Cancelled by user."
        $DownloadBtn.IsEnabled = $true
    })

    $global:progressWindow.Show()
}

function Show-CompleteDialog {
    [xml]$cXaml = @"
    <Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            Title="Download Complete" Height="200" Width="450"
            Background="#FF1E1E1E" Foreground="White" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True">
        <Grid Margin="20">
            <StackPanel>
                <TextBlock Text="✅ Download Completed Successfully!" FontSize="16" FontWeight="Bold" Foreground="#FF28A745" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="File has been saved to your directory." Foreground="#FFCCCCCC" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Name="CPlayBtn" Content="▶ Play Video" Width="100" Background="#FF007ACC" Foreground="White" BorderThickness="0" Padding="8,5" Margin="0,0,10,0"/>
                    <Button Name="CFolderBtn" Content="📂 Open Folder" Width="110" Background="#FF569CD6" Foreground="White" BorderThickness="0" Padding="8,5" Margin="0,0,10,0"/>
                    <Button Name="CCloseBtn" Content="Close" Width="80" Background="#FF4F4F4F" Foreground="White" BorderThickness="0" Padding="8,5"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Window>
"@
    $cReader = (New-Object System.Xml.XmlNodeReader $cXaml)
    $cWindow = [Windows.Markup.XamlReader]::Load($cReader)
    $cWindow.Owner = $window

    $cWindow.FindName("CPlayBtn").Add_Click({
        if (Test-Path $global:currentFilePath) { Invoke-Item $global:currentFilePath }
        $cWindow.Close()
    })
    $cWindow.FindName("CFolderBtn").Add_Click({
        if (Test-Path $SaveFolderInput.Text) { Invoke-Item $SaveFolderInput.Text }
        $cWindow.Close()
    })
    $cWindow.FindName("CCloseBtn").Add_Click({ $cWindow.Close() })

    $cWindow.ShowDialog() | Out-Null
}

# ---------------------------------------------------------
# Basic Button Events & Setup
# ---------------------------------------------------------
$window.Add_Loaded({
    $uiTimer.Start()
})

$BrowseBtn.Add_Click({
    $dialog = New-Object System.Windows.Forms.FolderBrowserDialog
    if ($dialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) { $SaveFolderInput.Text = $dialog.SelectedPath }
})

$OpenFolderBtn.Add_Click({
    if (Test-Path $SaveFolderInput.Text) { Invoke-Item $SaveFolderInput.Text }
})

# ---------------------------------------------------------
# Core Download Event (With Pro Options Added)
# ---------------------------------------------------------
$DownloadBtn.Add_Click({
    $url = $UrlInput.Text.Trim()
    if ([string]::IsNullOrEmpty($url)) {
        [System.Windows.MessageBox]::Show("Please enter a valid URL.", "Error")
        return
    }

    $currentExePath = [System.Diagnostics.Process]::GetCurrentProcess().MainModule.FileName
    $currentDir = Split-Path -Parent $currentExePath
    $ytdlpPath = Join-Path $currentDir "yt-dlp.exe"
    
    if (-not (Test-Path $ytdlpPath)) {
        [System.Windows.MessageBox]::Show("yt-dlp.exe is missing. Please restart the app.", "Error")
        return
    }

    $DownloadBtn.IsEnabled = $false
    $StatusLabel.Text = "Status: Downloading..."
    $StatusLabel.Foreground = "#FF28A745"
    
    $global:lastLogLineCount = 0
    $global:currentFilePath = ""
    $global:isPaused = $false
    New-Item -ItemType File -Path $global:tempLogFile -Force | Out-Null
    
    Show-ProgressDialog
    
    # Base arguments
    $args = @("--newline", "--no-warnings", "--continue")
    
    # Naming Format Logic
    $nameFormat = "%(title)s.%(ext)s"
    if ($NamingSelector.Text -match "Channel Name") { $nameFormat = "%(uploader)s - %(title)s.%(ext)s" }
    elseif ($NamingSelector.Text -match "Upload Date") { $nameFormat = "%(upload_date)s - %(title)s.%(ext)s" }
    $args += "-o", "`"$($SaveFolderInput.Text)\$nameFormat`""
    
    # Subtitles Logic
    if ($SubtitlesCheck.IsChecked) {
        $args += "--write-subs", "--write-auto-subs", "--sub-langs", "en,ur", "--embed-subs"
    }

    # Thumbnail Logic
    if ($ThumbnailCheck.IsChecked) {
        $args += "--write-thumbnail", "--convert-thumbnails", "jpg"
    }

    # Browser Cookies Logic
    if ($CookiesSelector.Text -ne "None (Default)") {
        $args += "--cookies-from-browser", $CookiesSelector.Text
    }
    
    # Playlist & Limits
    $pStart = $window.FindName("PlaylistStart").Text.Trim()
    $pEnd = $window.FindName("PlaylistEnd").Text.Trim()
    if ($pStart -match "^\d+$" -and [int]$pStart -gt 0) { $args += "--playlist-start", $pStart }
    if ($pEnd -match "^\d+$" -and [int]$pEnd -gt 0) { $args += "--playlist-end", $pEnd }
    if ($SpeedLimitSelector.Text -ne "Unlimited") { $args += "--limit-rate", $SpeedLimitSelector.Text }
    if ($ThreadsSelector.Text -match "16 Threads") { $args += "--concurrent-fragments", "16" }

    # Presets
    $preset = $PresetSelector.Text
    if ($preset -match "MP3") {
        $args += "-x", "--audio-format", "mp3"
    } elseif ($preset -match "TV MP4" -or $preset -match "MP4") {
        if ($preset -match "1080p") { $args += "-f", "bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" }
        elseif ($preset -match "720p") { $args += "-f", "bestvideo[height<=720][ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" }
        elseif ($preset -match "480p") { $args += "-f", "bestvideo[height<=480][ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" }
        $args += "--merge-output-format", "mp4"
    } elseif ($preset -match "MKV") {
        $args += "--merge-output-format", "mkv"
    } elseif ($preset -match "WebM") {
        $args += "-f", "bestvideo[ext=webm]+bestaudio[ext=webm]/best"
    }

    $args += $url

    $processInfo = New-Object System.Diagnostics.ProcessStartInfo
    $processInfo.FileName = $ytdlpPath
    $processInfo.Arguments = $args -join " "
    $processInfo.RedirectStandardOutput = $true
    $processInfo.RedirectStandardError = $true
    $processInfo.UseShellExecute = $false
    $processInfo.CreateNoWindow = $true

    $global:lastProcessInfo = $processInfo

    try {
        $global:activeProcess = [System.Diagnostics.Process]::Start($processInfo)
        
        $runspaceCode = {
            param($process, $logFile)
            while (-not $process.HasExited) {
                $line = $process.StandardOutput.ReadLine()
                if ($line) { Add-Content -Path $logFile -Value $line }
            }
        }
        $ps = [PowerShell]::Create().AddScript($runspaceCode).AddArgument($global:activeProcess).AddArgument($global:tempLogFile)
        $ps.BeginInvoke() | Out-Null
    }
    catch {
        $StatusLabel.Text = "Status: Error starting engine."
        $StatusLabel.Foreground = "#FFD13438"
        $DownloadBtn.IsEnabled = $true
        if ($global:progressWindow -ne $null) { $global:progressWindow.Close() }
    }
})

$window.ShowDialog() | Out-Null
