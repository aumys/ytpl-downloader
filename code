# ---------------------------------------------------------
# UI Timer - Queue Manager & Parser
# ---------------------------------------------------------
$uiTimer = New-Object System.Windows.Threading.DispatcherTimer
$uiTimer.Interval = [TimeSpan]::FromMilliseconds(500)
$uiTimer.Add_Tick({
    $logBox = if ($global:logsWindow -and $global:logsWindow.IsLoaded) { $global:logsWindow.FindName("LogBox") } else { $null }
    $activeCount = 0

    foreach ($task in $global:tasks) {
        if ($task.Status -eq "Downloading" -or $task.Status -eq "Connecting") {
            $activeCount++
            if (Test-Path $task.LogFile) {
                try {
                    $lines = [System.IO.File]::ReadAllLines($task.LogFile)
                    if ($lines.Length -gt $task.LastReadIndex) {
                        for ($i = $task.LastReadIndex; $i -lt $lines.Length; $i++) {
                            $line = $lines[$i]
                            if ($logBox) { $logBox.AppendText("[$($task.Engine)] $line`r`n"); $logBox.ScrollToEnd() }

                            if ($task.Engine -eq "yt-dlp") {
                                if ($line -match 'Destination:\s+(.+)') { $task.FileName = $matches[1] -replace '.*[\\/]', '' }
                                if ($line -match '(?<percent>\d+\.\d+)%\s+of\s+[~]*(?<size>[0-9A-Za-z\.]+)\s+at\s+(?<speed>[0-9A-Za-z\.\/]+)\s+ETA\s+(?<eta>[\d:]+)') {
                                    $task.Status = "Downloading"; $task.Progress = [double]$matches.percent; $task.Size = $matches.size
                                    $task.ProgressText = "$($matches.percent)%"
                                    $task.Downloaded = "$($matches.percent)% (Extracting...)"; $task.TransferRate = $matches.speed; $task.TimeLeft = $matches.eta
                                }
                            } else {
                                if ($line -match '\[#\w+\s+[^/]+/(?<size>[^\(]+)\((?<percent>\d+)%\).*?DL:(?<speed>[^\s]+).*?(ETA:(?<eta>[^\]]+))?\]') {
                                    $task.Status = "Downloading"; $task.Progress = [double]$matches.percent; $task.Size = $matches.size
                                    $task.ProgressText = "$($matches.percent)%"
                                    $task.Downloaded = "$($matches.percent)%" ; $task.TransferRate = $matches.speed
                                    if ($matches.eta) { $task.TimeLeft = $matches.eta }
                                }
                            }
                        }
                        $task.LastReadIndex = $lines.Length
                    }
                } catch {}
            }
            if ($null -ne $task.Process -and $task.Process.HasExited) {
                $activeCount--
                if ($task.Process.ExitCode -eq 0 -or $task.Progress -ge 99.9) {
                    $task.Status = "Finished"; $task.Progress = 100; $task.ProgressText = "100%"
                    $task.TransferRate = ""; $task.TimeLeft = ""; $task.Downloaded = $task.Size
                    $view.Refresh()
                    if ($task.OpenOnComplete -eq $true) { try { Invoke-Item $task.SavePath } catch {} }
                } else {
                    if ($task.Status -notin @("Paused", "Cancelled")) { $task.Status = "Error" }
                }
                $task.Process = $null
            }
        }
    }

    # Queue Manager
    if ($activeCount -lt [int]$global:defaultConcurrent) {
        $nextTask = $null
        foreach ($t in $global:tasks) { if ($t.Status -eq "Queued") { $nextTask = $t; break } }
        
        if ($null -ne $nextTask) {
            $nextTask.Status = "Connecting"
            try { 
                $nextTask.Process = [System.Diagnostics.Process]::Start($nextTask.StartInfo)
                Start-LogReader -Process $nextTask.Process -LogFile $nextTask.LogFile
            } catch { $nextTask.Status = "Error" }
        }
    }
})

