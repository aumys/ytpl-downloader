function Show-StatusDialog {
    param($Task)
    [xml]$statusXaml = @"
    <Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            Title="$($Task.FileName) - AUMYS Status" Height="380" Width="550" Background="#FFF0F0F0" WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize" FontFamily="Segoe UI">
        <Grid Margin="10">
            <TabControl Background="White" BorderBrush="#FFCCCCCC">
                <TabItem Header="Download status">
                    <Grid Margin="15">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBox Text="{Binding Url}" Grid.Row="0" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="0,0,0,15" TextWrapping="Wrap"/>
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                            <TextBlock Text="Status" Grid.Row="0" Grid.Column="0"/><TextBlock Text="{Binding Status}" Grid.Row="0" Grid.Column="1" Foreground="Blue"/>
                            <TextBlock Text="File size" Grid.Row="1" Grid.Column="0"/><TextBlock Text="{Binding Size}" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock Text="Downloaded" Grid.Row="2" Grid.Column="0"/><TextBlock Text="{Binding Downloaded}" Grid.Row="2" Grid.Column="1"/>
                            <TextBlock Text="Transfer rate" Grid.Row="3" Grid.Column="0"/><TextBlock Text="{Binding TransferRate}" Grid.Row="3" Grid.Column="1"/>
                            <TextBlock Text="Time left" Grid.Row="4" Grid.Column="0"/><TextBlock Text="{Binding TimeLeft}" Grid.Row="4" Grid.Column="1"/>
                            <TextBlock Text="Connections" Grid.Row="5" Grid.Column="0"/><TextBlock Text="16 (Multi-threaded)" Grid.Row="5" Grid.Column="1" Foreground="#FF28A745" FontWeight="SemiBold"/>
                            <TextBlock Text="Resume capability" Grid.Row="6" Grid.Column="0"/><TextBlock Text="Yes" Grid.Row="6" Grid.Column="1"/>
                        </Grid>
                        <ProgressBar Grid.Row="2" Value="{Binding Progress}" Height="18" Minimum="0" Maximum="100" Margin="0,0,0,15"/>
                        <Grid Grid.Row="3">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Name="SPauseBtn" Content="Pause" Width="80" Height="25" Margin="0,0,10,0" Background="#FFE1E1E1" BorderBrush="#FFADADAD"/>
                                <Button Name="SCancelBtn" Content="Cancel" Width="80" Height="25" Background="#FFE1E1E1" BorderBrush="#FFADADAD"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Options on completion">
                    <StackPanel Margin="20">
                        <TextBlock Text="Actions to perform when download finishes:" Margin="0,0,0,15" FontWeight="SemiBold"/>
                        <CheckBox Name="SOpenFolderCheck" Content="Open folder when download is complete" IsChecked="{Binding OpenOnComplete}"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Window>
"@
    $sReader = (New-Object System.Xml.XmlNodeReader $statusXaml)
    $sWin = [Windows.Markup.XamlReader]::Load($sReader)
    $sWin.Owner = $window
    $sWin.DataContext = $Task

    if ($Task.Status -in @("Paused", "Error", "Cancelled", "Queued")) { $sWin.FindName("SPauseBtn").Content = "Resume" }

    $sWin.FindName("SCancelBtn").Add_Click({
        param($sender, $e)
        $win = [System.Windows.Window]::GetWindow($sender)
        $ctx = $win.DataContext
        if ($null -ne $ctx) {
            if ($null -ne $ctx.Process) { try{ if (-not $ctx.Process.HasExited) { $ctx.Process.Kill() } }catch{} }
            $ctx.Status = "Cancelled"; $ctx.TransferRate = "Stopped"
        }
        $win.Close()
    })

    $sWin.FindName("SPauseBtn").Add_Click({
        param($sender, $e)
        $win = [System.Windows.Window]::GetWindow($sender)
        $ctx = $win.DataContext
        if ($null -ne $ctx) {
            if ($ctx.Status -in @("Paused", "Error", "Cancelled", "Queued")) {
                $ctx.Status = "Queued"; $ctx.TransferRate = "Waiting in queue..."
                $sender.Content = "Pause"
            } else {
                if ($null -ne $ctx.Process) { try { if (-not $ctx.Process.HasExited) { $ctx.Process.Kill() } } catch {} }
                $ctx.Status = "Paused"; $ctx.TransferRate = "Stopped"
                $sender.Content = "Resume"
            }
        }
    })
    $sWin.Show()
}

