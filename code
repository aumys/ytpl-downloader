$code = @"
using System;
using System.ComponentModel;
using System.Diagnostics;

public class DownloadTask : INotifyPropertyChanged {
    public event PropertyChangedEventHandler PropertyChanged;
    private void Notify(string prop) { if (PropertyChanged != null) { PropertyChanged(this, new PropertyChangedEventArgs(prop)); } }

    private string _fileName; public string FileName { get{return _fileName;} set{_fileName=value; Notify("FileName");} }
    private string _status; public string Status { get{return _status;} set{_status=value; Notify("Status");} }
    private string _size; public string Size { get{return _size;} set{_size=value; Notify("Size");} }
    private string _downloaded; public string Downloaded { get{return _downloaded;} set{_downloaded=value; Notify("Downloaded");} }
    private string _progressText; public string ProgressText { get{return _progressText;} set{_progressText=value; Notify("ProgressText");} }
    private double _progress; public double Progress { get{return _progress;} set{_progress=value; Notify("Progress");} }
    private string _transferRate; public string TransferRate { get{return _transferRate;} set{_transferRate=value; Notify("TransferRate");} }
    private string _timeLeft; public string TimeLeft { get{return _timeLeft;} set{_timeLeft=value; Notify("TimeLeft");} }
    private bool _openOnComplete; public bool OpenOnComplete { get{return _openOnComplete;} set{_openOnComplete=value; Notify("OpenOnComplete");} }

    public string Id { get; set; }
    public string Url { get; set; }
    public string Engine { get; set; }
    public string LogFile { get; set; }
    public string SavePath { get; set; }
    public Process Process { get; set; }
    public ProcessStartInfo StartInfo { get; set; }
    public int LastReadIndex { get; set; }
}
"@
Add-Type -TypeDefinition $code -Language CSharp

