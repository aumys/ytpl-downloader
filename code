# Helper to read logs asynchronously
function Start-LogReader {
    param($Process, $LogFile)
    if ($null -eq $Process) { return }
    $runspaceCode = {
        param($proc, $log)
        if ($proc -eq $null) { return }
        try { while (-not $proc.HasExited) { $l = $proc.StandardOutput.ReadLine(); if ($l) { Add-Content $log $l } } } catch {}
    }
    $ps = [PowerShell]::Create().AddScript($runspaceCode).AddArgument($Process).AddArgument($LogFile)
    $global:logReaders += @{ PS = $ps; Handle = $ps.BeginInvoke() }
}

